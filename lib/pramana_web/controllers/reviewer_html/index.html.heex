<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  private_reviewer={!!assigns[:private_reviewer]}
>
  <div class="space-y-8" id="reviewer-workspace">
    <section class="rounded-3xl border border-base-300 bg-base-200/50 p-6 sm:p-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="max-w-2xl space-y-3">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">
            Source review · exact pilot scope
          </p>
          <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
            Review the sources, one decision at a time.
          </h1>
          <p class="text-base-content/70">
            Check each work's identity and edition, then examine any links still needing review.
            Every recommendation records your reason and the source you checked.
          </p>
        </div>
        <span class="badge badge-outline h-auto max-w-full px-3 py-2 text-xs">
          {@account.email}
        </span>
      </div>

      <div class="mt-7 grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl bg-base-100 p-4 shadow-sm">
          <p class="text-sm text-base-content/60">Your work reviews</p>
          <p class="mt-1 text-3xl font-semibold">
            {Enum.count(@works, & &1.judgment)}
            <span class="text-base font-normal text-base-content/60">/ {length(@works)}</span>
          </p>
          <p class="mt-1 text-xs text-base-content/60">
            A saved recommendation for this exact scope
          </p>
        </div>
        <div class="rounded-2xl bg-base-100 p-4 shadow-sm">
          <p class="text-sm text-base-content/60">Links to inspect</p>
          <p class="mt-1 text-3xl font-semibold">{length(@cases)}</p>
          <p class="mt-1 text-xs text-base-content/60">Still marked needs review in the corpus</p>
        </div>
        <div class="rounded-2xl bg-base-100 p-4 shadow-sm">
          <p class="text-sm text-base-content/60">Rights decisions</p>
          <p class="mt-1 text-xl font-semibold">Separate signoff</p>
          <a
            :if={@rights_granted}
            href="/reviews/rights"
            class="link link-primary mt-1 inline-block text-sm"
          >
            Open rights checklist →
          </a>
          <p :if={!@rights_granted} class="mt-1 text-xs text-base-content/60">
            Requires a separate rights grant
          </p>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={
            case Enum.find(@works, &is_nil(&1.judgment)) do
              nil -> "#works"
              item -> "/reviews/works/#{item.work["work_id"]}"
            end
          }
          class="btn btn-primary"
          id="continue-work-review"
        >
          Continue work review <span aria-hidden="true">→</span>
        </a>
        <a href="#links" class="btn btn-ghost">See uncertain links</a>
      </div>
    </section>

    <section id="works" aria-labelledby="works-heading" class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">
            01 / Source set
          </p>
          <h2 id="works-heading" class="mt-1 text-2xl font-semibold">Works to check</h2>
          <p class="mt-1 text-sm text-base-content/70">
            Answer-scope works and distinct targets of uncertain links. Open a work to record your recommendation.
          </p>
        </div>
        <span class="badge badge-neutral badge-outline">{length(@works)} works</span>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-base-300 bg-base-100">
        <table class="table table-zebra min-w-[40rem]">
          <caption class="sr-only">
            Works in the exact pilot scope and your latest source recommendation
          </caption>
          <thead>
            <tr>
              <th scope="col">Work</th>
              <th scope="col">Place in pilot</th>
              <th scope="col">Your review</th>
              <th scope="col"><span class="sr-only">Open</span></th>
            </tr>
          </thead>
          <tbody>
            <tr :for={item <- @works} id={"work-#{item.work["work_id"]}"}>
              <td>
                <div class="font-medium" lang="zh-Hant">{item.work["title"]}</div>
                <div class="mt-0.5 text-xs text-base-content/60">
                  {item.work["work_id"]} · {item.work["text_role"]} · {item.work["source"]}/{item.work[
                    "witness"
                  ]}
                </div>
              </td>
              <td>
                <span :if={item.work["answer_scope"]} class="badge badge-ghost badge-sm">
                  Answer scope
                </span>
                <span
                  :if={item.work["review_target"]}
                  class="badge badge-warning badge-outline badge-sm"
                >
                  Link target
                </span>
              </td>
              <td>
                <span :if={is_nil(item.judgment)} class="text-sm text-base-content/55">
                  Not reviewed
                </span>
                <span :if={item.judgment} class="badge badge-success badge-outline badge-sm">
                  {String.replace(item.judgment.judgment, "_", " ")}
                </span>
              </td>
              <td class="text-right">
                <a
                  href={"/reviews/works/#{item.work["work_id"]}"}
                  class="link link-primary whitespace-nowrap"
                >
                  Review <span aria-hidden="true">→</span>
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="links" aria-labelledby="links-heading" class="space-y-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">
          02 / Link evidence
        </p>
        <h2 id="links-heading" class="mt-1 text-2xl font-semibold">Uncertain commentary links</h2>
        <p class="mt-1 text-sm text-base-content/70">
          Shared words suggest a link, but they do not prove which text a commentary explains.
        </p>
      </div>
      <div class="grid gap-3">
        <p :if={@cases == []} class="text-sm text-base-content/70">
          No commentary links currently need review in this scope.
        </p>
        <a
          :for={item <- @cases}
          href={"/reviews/#{item.id}"}
          class="group rounded-2xl border border-base-300 bg-base-100 p-5 transition hover:border-primary hover:shadow-sm"
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="font-medium">
                {item.candidate.source_work_id}
                <span aria-hidden="true">→</span> {item.candidate.target_work_id}
              </p>
              <p class="mt-1 text-sm text-base-content/65">
                {item.candidate.assertion["review_reason"]}
              </p>
            </div>
            <span class="badge badge-warning badge-outline">Needs review</span>
          </div>
          <p class="mt-3 text-sm font-medium text-primary group-hover:underline">
            Examine evidence <span aria-hidden="true">→</span>
          </p>
        </a>
      </div>
    </section>

    <section
      class="rounded-2xl border border-base-300 p-5 text-sm text-base-content/70"
      aria-label="Review limits"
    >
      <p class="font-medium text-base-content">What your review records</p>
      <p class="mt-1">
        These are attributed source recommendations. An operator handles corpus changes, and a rights decision-maker handles allowed uses. Nothing here silently clears a warning or expands answer scope.
      </p>
      <details class="mt-3">
        <summary class="cursor-pointer font-medium">Exact scope identity</summary>
        <code class="mt-2 block break-all text-xs">{@scope_sha256}</code>
      </details>
    </section>
  </div>
</Layouts.app>
