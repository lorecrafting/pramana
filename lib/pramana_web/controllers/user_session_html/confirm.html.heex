<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  private_reviewer={!!assigns[:private_reviewer]}
>
  <div class="mx-auto max-w-sm">
    <div class="text-center">
      <.header>Welcome {@user.email}</.header>
    </div>

    <.form
      :if={!@user.confirmed_at}
      for={@form}
      id="confirmation_form"
      action="/users/log-in?_action=confirmed"
      phx-mounted={JS.focus_first()}
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
      <.button
        :if={!assigns[:private_reviewer]}
        name={@form[:remember_me].name}
        value="true"
        phx-disable-with="Confirming..."
        class="btn btn-primary w-full"
      >
        Confirm and stay logged in
      </.button>
      <.button phx-disable-with="Confirming..." class="btn btn-primary btn-soft w-full mt-2">
        {if assigns[:private_reviewer],
          do: "Confirm and log in",
          else: "Confirm and log in only this time"}
      </.button>
    </.form>

    <.form
      :if={@user.confirmed_at}
      for={@form}
      id="login_form"
      action="/users/log-in"
      phx-mounted={JS.focus_first()}
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
      <%= if @current_scope do %>
        <.button variant="primary" phx-disable-with="Logging in..." class="btn btn-primary w-full">
          Log in
        </.button>
      <% else %>
        <.button
          :if={!assigns[:private_reviewer]}
          name={@form[:remember_me].name}
          value="true"
          phx-disable-with="Logging in..."
          class="btn btn-primary w-full"
        >
          Keep me logged in on this device
        </.button>
        <.button phx-disable-with="Logging in..." class="btn btn-primary btn-soft w-full mt-2">
          {if assigns[:private_reviewer], do: "Log in", else: "Log me in only this time"}
        </.button>
      <% end %>
    </.form>

    <p :if={!@user.confirmed_at} class="alert alert-outline mt-8">
      Tip: If you prefer passwords, you can enable them in the user settings.
    </p>
  </div>
</Layouts.app>
