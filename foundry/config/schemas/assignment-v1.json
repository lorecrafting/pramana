{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pramana-workflow/assignment-v1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/worker_assignment"},
    {"$ref": "#/$defs/pm_assignment"}
  ],
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "string_array": {
      "type": "array",
      "items": {"type": "string"}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "corpus", "gpu", "service_ports", "other"],
      "properties": {
        "database": {"$ref": "#/$defs/string_array"},
        "corpus": {"$ref": "#/$defs/string_array"},
        "gpu": {"$ref": "#/$defs/string_array"},
        "service_ports": {"$ref": "#/$defs/string_array"},
        "other": {"$ref": "#/$defs/string_array"}
      }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "outcome", "priority", "evidence", "dependencies", "scope",
        "exclusions", "acceptance_criteria", "required_checks", "review_required_checks",
        "checkout", "base_revision", "role", "model", "requested_operations",
        "handoff_path", "review_path", "workload"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/non_empty_string"},
        "outcome": {"$ref": "#/$defs/non_empty_string"},
        "priority": {"type": "string", "pattern": "^P[0-9]+$"},
        "evidence": {"$ref": "#/$defs/string_array"},
        "dependencies": {"$ref": "#/$defs/string_array"},
        "scope": {"$ref": "#/$defs/string_array"},
        "exclusions": {"$ref": "#/$defs/string_array"},
        "acceptance_criteria": {"$ref": "#/$defs/string_array"},
        "required_checks": {"type": "array", "items": {"$ref": "#/$defs/argv"}},
        "review_required_checks": {"type": "array", "items": {"$ref": "#/$defs/argv"}},
        "integration_only_checks": {"type": "array", "items": {"$ref": "#/$defs/argv"}},
        "review_inspection_only_reason": {"$ref": "#/$defs/non_empty_string"},
        "checkout": {"$ref": "#/$defs/non_empty_string"},
        "base_revision": {"$ref": "#/$defs/sha1"},
        "role": {"const": "developer"},
        "model": {"$ref": "#/$defs/non_empty_string"},
        "profile": {"$ref": "#/$defs/non_empty_string"},
        "reasoning": {"$ref": "#/$defs/non_empty_string"},
        "risk": {"$ref": "#/$defs/non_empty_string"},
        "reviewer_profile": {"$ref": "#/$defs/non_empty_string"},
        "work_class": {"$ref": "#/$defs/non_empty_string"},
        "work_timeout_seconds": {"type": "integer", "minimum": 1},
        "check_timeout_seconds": {"type": "integer", "minimum": 1},
        "requested_operations": {"$ref": "#/$defs/string_array"},
        "handoff_path": {"$ref": "#/$defs/non_empty_string"},
        "review_path": {"$ref": "#/$defs/non_empty_string"},
        "workload": {"enum": ["lightweight", "standard", "heavy"]},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "shared_resources": {"$ref": "#/$defs/resources"},
        "scheduling_decision": {"type": "object"}
      }
    },
    "worker_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "task_id", "run_id", "role", "accepted_revision",
        "assignment_path", "proposal_path", "disabled_operations", "configured_model",
        "configured_model_id", "configured_profile", "configured_reasoning",
        "expected_checkout_head", "ticket"
      ],
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "reviewer"}}},
          "then": {"required": ["candidate_commit", "handoff"]}
        }
      ],
      "properties": {
        "schema_version": {"const": 1},
        "task_id": {"$ref": "#/$defs/non_empty_string"},
        "run_id": {"$ref": "#/$defs/non_empty_string"},
        "role": {"enum": ["developer", "reviewer"]},
        "accepted_revision": {"anyOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
        "assignment_path": {"$ref": "#/$defs/non_empty_string"},
        "proposal_path": {"type": "null"},
        "disabled_operations": {"$ref": "#/$defs/string_array"},
        "configured_model": {"$ref": "#/$defs/non_empty_string"},
        "configured_model_id": {"$ref": "#/$defs/non_empty_string"},
        "configured_profile": {"$ref": "#/$defs/non_empty_string"},
        "configured_reasoning": {"$ref": "#/$defs/non_empty_string"},
        "expected_checkout_head": {"$ref": "#/$defs/sha1"},
        "ticket": {"$ref": "#/$defs/ticket"},
        "candidate_commit": {"anyOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
        "continuation": {"anyOf": [{"type": "object", "minProperties": 1}, {"type": "null"}]},
        "correction": {"anyOf": [{"type": "object", "minProperties": 1}, {"type": "null"}]},
        "handoff": {"anyOf": [{"type": "object", "minProperties": 1}, {"type": "null"}]}
      }
    },
    "pm_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "task_id", "run_id", "role", "accepted_revision",
        "assignment_path", "proposal_path", "audit_path", "profile", "configured_model",
        "configured_model_id", "configured_reasoning", "max_proposals", "allowed_operations",
        "disabled_operations", "planning_context", "native_entrypoint"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "task_id": {"const": "PM"},
        "run_id": {"$ref": "#/$defs/non_empty_string"},
        "role": {"const": "pm"},
        "accepted_revision": {"$ref": "#/$defs/sha1"},
        "assignment_path": {"$ref": "#/$defs/non_empty_string"},
        "proposal_path": {"$ref": "#/$defs/non_empty_string"},
        "audit_path": {"type": ["string", "null"]},
        "profile": {"$ref": "#/$defs/non_empty_string"},
        "configured_model": {"$ref": "#/$defs/non_empty_string"},
        "configured_model_id": {"$ref": "#/$defs/non_empty_string"},
        "configured_reasoning": {"$ref": "#/$defs/non_empty_string"},
        "max_proposals": {"type": "integer", "minimum": 1},
        "allowed_operations": {"$ref": "#/$defs/string_array"},
        "disabled_operations": {"$ref": "#/$defs/string_array"},
        "planning_context": {"type": "object"},
        "native_entrypoint": {"enum": ["AGENTS.md", "CLAUDE.md"]}
      }
    }
  }
}
