#!/usr/bin/env bash
# pramana — CLI wrapper for Pramāṇa Foundry agent commands.
#
# Routes all commands to the running daemon via the release binary's `rpc`
# so agent-facing commands (handoff submit, review submit, ticket status)
# execute in the daemon's BEAM and can call the Coordinator GenServer.
#
# Works from both the main repo and OMP worktrees.
#
# Usage:
#   pramana handoff submit TASK_ID --handoff-path PATH
#   pramana handoff block TASK_ID --reason TEXT
#   pramana review submit TASK_ID --review-path PATH
#   pramana ticket status TASK_ID
#   pramana ticket list
#   pramana ticket create --title TITLE --priority P0|P1|P2|P3

set -euo pipefail

# ── Resolve release binary path ──

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FOUNDRY_DIR="$(dirname "$SCRIPT_DIR")"
PROJECT_ROOT="$(dirname "$FOUNDRY_DIR")"

# `lane` commands go to the lane daemon that bin/foundry-lane starts (its own release and
# node name), never to a legacy daemon. Explicit PRAMANA_RELEASE and RELEASE_NODE still win.
if [ "${1:-}" = "lane" ]; then
  eval "$("$SCRIPT_DIR/foundry-lane" env)"
fi

# 1. Try relative to script (main repo case)
RELEASE_BIN="$FOUNDRY_DIR/_build/prod/rel/pramana_foundry/bin/pramana_foundry"

# 2. Try env var override. An explicit but invalid override is an error; silently
# falling back could send a command to a different daemon than the caller chose.
if [ -n "${PRAMANA_RELEASE:-}" ]; then
  if [ ! -x "$PRAMANA_RELEASE" ]; then
    echo "Error: PRAMANA_RELEASE is not executable: $PRAMANA_RELEASE" >&2
    exit 69
  fi

  RELEASE_BIN="$PRAMANA_RELEASE"
fi

# 3. Worktree detection via .git file
if [ ! -x "$RELEASE_BIN" ]; then
  GIT_FILE="$PROJECT_ROOT/.git"
  if [ -f "$GIT_FILE" ]; then
    GITDIR_LINE=$(head -1 "$GIT_FILE" 2>/dev/null || echo "")
    case "$GITDIR_LINE" in
      gitdir:*)
        MAIN_DIR="${GITDIR_LINE#gitdir: }"
        MAIN_DIR="${MAIN_DIR%/.git*}"
        RELEASE_BIN="$MAIN_DIR/foundry/_build/prod/rel/pramana_foundry/bin/pramana_foundry"
        ;;
    esac
  fi
fi

# 4. Last resort: common user paths
if [ ! -x "$RELEASE_BIN" ]; then
  for candidate in \
    "$HOME/dev/pramana/foundry/_build/prod/rel/pramana_foundry/bin/pramana_foundry" \
    "$HOME/pramana/foundry/_build/prod/rel/pramana_foundry/bin/pramana_foundry"; do
    if [ -x "$candidate" ]; then
      RELEASE_BIN="$candidate"
      break
    fi
  done
fi

if [ ! -x "$RELEASE_BIN" ]; then
  echo "Error: cannot find pramana_foundry release binary" >&2
  echo "" >&2
  echo "The release binary is at foundry/_build/prod/rel/pramana_foundry/bin/pramana_foundry" >&2
  echo "Build it from the main repo:" >&2
  echo "  cd foundry && MIX_ENV=prod mix release" >&2
  echo "" >&2
  echo "Or set PRAMANA_RELEASE env var:" >&2
  echo "  export PRAMANA_RELEASE=/path/to/pramana/foundry/_build/prod/rel/pramana_foundry/bin/pramana_foundry" >&2
  exit 1
fi

# ── Encode arguments as inert data for the fixed RPC entry point ──

# The decoded JSON envelope is capped at 64 KiB. Its unpadded URL-safe Base64
# representation stays below 88 KiB, leaving margin under common per-argument
# operating-system limits. The encoded alphabet cannot terminate the Elixir string
# or introduce interpolation; the daemon independently validates canonical encoding.
encode_for_rpc() {
  elixir -e '
try do
  raw =
    %{"version" => 1, "argv" => System.argv()}
    |> :json.encode()
    |> IO.iodata_to_binary()

  if byte_size(raw) > 65_536 do
    IO.puts(:stderr, "Error: RPC argument payload exceeds 65536 bytes")
    System.halt(64)
  end

  IO.write(Base.url_encode64(raw, padding: false))
rescue
  error ->
    IO.puts(:stderr, "Error: could not encode RPC arguments: #{Exception.message(error)}")
    System.halt(65)
end
' -- "$@"
}

if PAYLOAD=$(encode_for_rpc "$@"); then
  RPC_CODE="PramanaFoundry.CLI.RPC.run(\"${PAYLOAD}\")"
else
  ENCODE_STATUS=$?
  exit "$ENCODE_STATUS"
fi

# ── Execute on daemon node via RPC ──

# Preserve the release command's stdout, stderr and exact status. A nonzero result
# may be a command rejection rather than a connection failure, so do not relabel it.
if "$RELEASE_BIN" rpc "$RPC_CODE"; then
  exit 0
else
  exit $?
fi
