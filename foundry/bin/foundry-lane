#!/usr/bin/env bash
# foundry-lane — build, start and stop the manual-lane daemon (docs/batch-d/LANE-RUNBOOK.md).
#
# The lane daemon runs ManualLane.Server alone (no Coordinator, Improver or PM) on its own
# release build, node name and runtime root, so it never collides with a legacy daemon.
# Every setting below can be overridden from the environment. `bin/pramana lane …` reads
# the same settings through `foundry-lane env`.
#
# Usage: foundry-lane build|start|stop|status|env

set -euo pipefail

FOUNDRY_DIR="$(cd "$(dirname "$0")/.." && pwd)"

: "${FOUNDRY_LANE_BUILD:=/private/tmp/foundry-lane-build}"
: "${PRAMANA_RELEASE:=$FOUNDRY_LANE_BUILD/rel/pramana_foundry/bin/pramana_foundry}"
: "${RELEASE_NODE:=foundry_lane}"
: "${PRAMANA_RUNTIME_ROOT:=$HOME/.local/state/foundry-lane}"
: "${FOUNDRY_MANUAL_LANE_REPO:=$(dirname "$FOUNDRY_DIR")}"
: "${FOUNDRY_MANUAL_LANE_POLICY:=$FOUNDRY_DIR/docs/batch-d/lane-policy.example.json}"
FOUNDRY_MANUAL_LANE=1
VARS="FOUNDRY_LANE_BUILD PRAMANA_RELEASE RELEASE_NODE PRAMANA_RUNTIME_ROOT FOUNDRY_MANUAL_LANE
FOUNDRY_MANUAL_LANE_REPO FOUNDRY_MANUAL_LANE_POLICY"
# shellcheck disable=SC2086
export $VARS

need_release() {
  [ -x "$PRAMANA_RELEASE" ] || { echo "no lane release at $PRAMANA_RELEASE; run: $0 build" >&2; exit 69; }
}

case "${1:-}" in
  env)
    for v in $VARS; do printf 'export %s=%q\n' "$v" "${!v}"; done
    ;;
  build)
    cd "$FOUNDRY_DIR"
    MIX_ENV=prod MIX_BUILD_PATH="$FOUNDRY_LANE_BUILD" mix release --overwrite
    ;;
  start)
    need_release
    if "$PRAMANA_RELEASE" pid >/dev/null 2>&1; then echo "lane daemon already running" >&2; exit 0; fi
    mkdir -p "$PRAMANA_RUNTIME_ROOT"
    # A release boots with plain args ["--no-halt"], which Application reads as a client.
    PRAMANA_STARTUP_MODE=daemon "$PRAMANA_RELEASE" daemon
    for _ in $(seq 30); do
      if "$PRAMANA_RELEASE" pid >/dev/null 2>&1; then exec "$FOUNDRY_DIR/bin/pramana" lane status; fi
      sleep 1
    done
    echo "lane daemon did not come up; see $FOUNDRY_LANE_BUILD/rel/pramana_foundry/tmp/log" >&2
    exit 1
    ;;
  stop)
    need_release
    "$PRAMANA_RELEASE" stop
    ;;
  status)
    need_release
    echo "node $RELEASE_NODE pid $("$PRAMANA_RELEASE" pid)"
    exec "$FOUNDRY_DIR/bin/pramana" lane status
    ;;
  *)
    echo "usage: $0 build|start|stop|status|env" >&2
    exit 64
    ;;
esac
