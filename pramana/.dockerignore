# Pramāṇa .dockerignore
#
# Multi-GB local data that would bloat the build context and cache:
raw/
evals/
sources.lock.json
sources.public.lock.json

# Toolchain caches that the builder installs fresh:
deps/
_build/
apps/pramana_native/native/**/target/
priv/plts/
priv/models/

# IDE junk, OS metadata:
.elixir_ls/
.idea/
*.swp
.DS_Store

# Node.js (not used by the app, but present from asset pipelining):
node_modules/
# This is Pramāṇa's build context, not a build of the whole repository.
# Neither path is a Dockerfile COPY input. Git ignores do not filter Docker context.
.git/
foundry/

# Build with `docker build ./pramana`, never the repository root. Only the
# tracked folio-image metadata in priv/derge is included, not source text/models.
sources/local/*/text/
sources/local/*/raw/
priv/embed/.venv/
priv/embed/models/
priv/train/
**/__pycache__/
**/*.pyc
native/quotations/target/
