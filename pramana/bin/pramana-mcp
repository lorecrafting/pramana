#!/usr/bin/env bash
#
# Launches the Pramāṇa MCP server over stdio, for Claude Code and other local clients.
#
# Two things this wrapper exists to guarantee:
#
#   1. The pinned toolchain is on PATH. mise is path-keyed and not active in a
#      non-interactive shell, so `mix` would otherwise resolve to whatever Elixir is
#      global — or to nothing at all.
#   2. NOTHING but JSON-RPC reaches stdout. On stdio, stdout *is* the protocol
#      channel: a single "Compiling 3 files" line corrupts the stream and the client
#      reports an opaque parse error. So we compile first, with all output forced to
#      stderr, and only then hand stdout to the server.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if command -v mise >/dev/null 2>&1; then
  eval "$(mise env -s bash)" >/dev/null 2>&1 || true
elif [ -x /opt/homebrew/bin/mise ]; then
  eval "$(/opt/homebrew/bin/mise env -s bash)" >/dev/null 2>&1 || true
fi

export PATH="/opt/homebrew/opt/postgresql@18/bin:$PATH"
export MIX_ENV="${MIX_ENV:-dev}"

# Warm the build with stdout redirected to stderr, so compiler chatter cannot enter
# the protocol stream.
mix compile 1>&2

exec mix pramana.mcp.stdio
