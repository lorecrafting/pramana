#!/usr/bin/env bash
#
# Runs the Modal CLI from the project's own virtualenv.
#
# Modal is a Python tool in an otherwise Elixir project, and it is deliberately NOT
# installed system-wide: macOS ships Python 3.9 as `python3`, Homebrew Python refuses
# `pip install` outside a venv ("externally-managed-environment"), and a stray global
# install is the kind of thing that works today and breaks after a `brew upgrade`.
#
#   bin/pramana-modal setup                 # one-time, opens a browser to authenticate
#   bin/pramana-modal volume create pramana-embed
#   bin/pramana-modal volume put pramana-embed /tmp/pramana_chunks.jsonl /chunks.jsonl
#   bin/pramana-modal run priv/embed/modal_embed.py
#
# See docs/GPU_RUNBOOK.md step 1 for creating the venv.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DATA_ROOT="${PRAMANA_DATA_ROOT-$ROOT}"
if [[ "$DATA_ROOT" != /* ]]; then
  echo "PRAMANA_DATA_ROOT must be an absolute path" >&2
  exit 2
fi
VENV="${PRAMANA_MODAL_VENV-$DATA_ROOT/priv/embed/.venv}"
if [[ "$VENV" != /* ]]; then
  echo "PRAMANA_MODAL_VENV must be an absolute path" >&2
  exit 2
fi

if [ ! -x "$VENV/bin/modal" ]; then
  echo "Modal is not installed in $VENV" >&2
  echo >&2
  echo "Create it with:" >&2
  echo "  python3 -m venv \"$VENV\"" >&2
  echo "  \"$VENV/bin/pip\" install modal" >&2
  exit 1
fi

# Legacy root calls used `run priv/embed/name.py`; preserve that narrow alias
# without changing arbitrary user paths or the working directory.
args=("$@")
for i in "${!args[@]}"; do
  case "${args[$i]}" in
    priv/embed/*.py)
      if [ ! -e "${args[$i]}" ] && [ -f "$ROOT/${args[$i]}" ]; then
        args[$i]="$ROOT/${args[$i]}"
      fi
      ;;
  esac
done
exec "$VENV/bin/modal" "${args[@]}"
